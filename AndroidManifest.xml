<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.pda.launcher"
    android:versionCode="3"
    android:versionName="3.0">

    <!-- targetSdk 28 keeps legacy storage for the Files tab: the whole of shared
         storage through java.io.File with the plain storage permission. From 30
         on that needs "All files access" (docs/files.md). -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The glance line's next event, only if the user turns it on. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- The Files tab: shared storage, and opening an .apk. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The audio player plays on with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Home">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="uiMode|orientation|screenSize|keyboardHidden|keyboard"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateUnspecified|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Capture: an app of its own (a key can open it), a line into the inbox
             or the tasks. Its own task, so the launcher is left as it was. -->
        <activity
            android:name=".CaptureActivity"
            android:label="Capture"
            android:icon="@drawable/ic_capture"
            android:roundIcon="@drawable/ic_capture"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="org.pda.launcher.capture"
            android:launchMode="singleTask"
            android:theme="@style/Capture"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share › Show on Board: text from another app onto the Today tab's board. -->
        <activity
            android:name=".ShareToNote"
            android:label="Show on Board"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Share › Add to Inbox: a capture in the Today tab's inbox.md. -->
        <activity
            android:name=".ShareToInbox"
            android:label="Add to Inbox"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The built-in viewers (Prefs › Viewers): each in its own task, as an app,
             so Home leaves it in Recents and the launcher as it was. -->
        <activity
            android:name=".viewers.TextEditorActivity"
            android:label="Text"
            android:taskAffinity="org.pda.launcher.text"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".viewers.ImageViewerActivity"
            android:label="Images"
            android:taskAffinity="org.pda.launcher.image"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".viewers.AudioPlayerActivity"
            android:label="Audio"
            android:taskAffinity="org.pda.launcher.audio"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".viewers.PdfViewerActivity"
            android:label="PDF"
            android:taskAffinity="org.pda.launcher.pdf"
            android:configChanges="orientation|screenSize" />

        <provider
            android:name=".files.FileShare"
            android:authorities="org.pda.launcher.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
