#!/system/bin/sh
#
# net -- basic network info (docs/shell.md). A thin wrapper: the
# capability (the device's own DNS) comes from `android net.dns`; this adds
# nothing Android-only, so it has no socket call of its own beyond that.
#
#   net dns             the device's DNS servers
#   net check [HOST]    reachable? (default host: the first DNS server)
set -u
I="${DN_INSTDIR:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"

case "${1:-dns}" in
  dns) "$I/bin/android" net.dns ;;
  check)
    host=${2:-}
    if [ -z "$host" ]; then
      servers=$("$I/bin/android" net.dns | sed -n 's/^servers=//p')
      # toybox's ping has no -6: prefer an IPv4 server, since one is usually there.
      host=$(printf '%s
' "$servers" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1)
      [ -n "$host" ] || host=$(printf '%s
' "$servers" | head -n 1)
      [ -n "$host" ] || { echo "net: no DNS server known" >&2; exit 1; }
    fi
    if ping -c 1 -W 2 "$host" >/dev/null 2>&1; then
      echo "net: $host is reachable"
    else
      echo "net: $host is not reachable" >&2
      exit 1
    fi ;;
  *) echo "usage: net dns | check [HOST]" >&2; exit 64 ;;
esac
