#!/system/bin/sh
#
# config -- the settings, as files (docs/shell.md).
#
# A setting is one file, etc/<key with dots as directories>, holding one line.
# lib/config.schema describes every setting (type, default, constraint). The
# app watches etc/ and follows a change at once; this command works with the
# app stopped, and so does a hand edit.
#
# A `family` setting (for example storage.link) is a directory instead of a
# file: each member is named, holds one value, and is reached as
# KEY.NAME (storage.link.Download -> etc/storage/link/Download). The schema's
# `constraint` column for a family row is the member's type (checked the same
# way as any other type); its defaults, seeded once, come from the sidecar
# lib/config.KEY.defaults (name, a TAB, the value).
#
#   config list              every setting (family members listed as KEY.NAME=...)
#   config get KEY[.NAME]
#   config set KEY[.NAME] VALUE     checked against the schema, written atomically
#   config unset KEY.NAME           a family member is deleted
#   config reset KEY                a plain setting's file is written with its default
#   config seed               create every missing file/family, with its defaults
set -u
I="${DN_INSTDIR:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
SCHEMA="$I/lib/config.schema"
T=$(printf '\t')
NL='
'

die()  { printf 'config: %s\n' "$*" >&2; exit 1; }
usage() { echo "usage: config list | get KEY[.NAME] | set KEY[.NAME] VALUE | unset KEY.NAME | reset KEY | seed" >&2; exit 64; }

# split LINE -> k t d c (key, type, default, constraint). Empty fields survive.
split() {
  k=${1%%"$T"*}; r=${1#*"$T"}
  t=${r%%"$T"*}; r=${r#*"$T"}
  d=${r%%"$T"*}; r=${r#*"$T"}
  c=${r%%"$T"*}
}

# lookup KEY -> sets k t d c to the schema row whose key is exactly KEY.
lookup() {
  while IFS= read -r line; do
    case $line in ''|'#'*) continue ;; esac
    split "$line"
    [ "$k" = "$1" ] && return 0
  done < "$SCHEMA"
  return 1
}

# resolve KEY -> a plain setting (lookup succeeds, k=KEY) or a family member
# (the longest leading part of KEY names a family row): sets k t d c and
# FAMILY (1 for a member, 0 for a plain setting or a family named directly).
resolve() {
  FAMILY=0
  lookup "$1" && return 0
  rest=$1
  while :; do
    case $rest in *.*) rest=${rest%.*} ;; *) return 1 ;; esac
    if lookup "$rest" && [ "$t" = family ]; then
      FAMILY=1; k=$1; t=$c; d=''; c=''
      return 0
    fi
  done
}

path() { printf '%s/etc/%s' "$I" "$(printf '%s' "$1" | tr . /)"; }

# valid TYPE CONSTRAINT VALUE
valid() {
  v=$3
  case $v in *"$NL"*) echo "must be one line"; return 1 ;; esac
  case $1 in
    int)
      case $v in ''|*[!0-9]*) echo "not a whole number"; return 1 ;; esac
      if [ -n "$2" ]; then
        lo=${2%-*}; hi=${2#*-}
        { [ "$v" -ge "$lo" ] && [ "$v" -le "$hi" ]; } || { echo "out of range $2"; return 1; }
      fi ;;
    bool)
      case $v in true|false) ;; *) echo "must be true or false"; return 1 ;; esac ;;
    enum)
      ok=1; old=$IFS; IFS='|'
      for x in $2; do [ "$x" = "$v" ] && ok=0; done
      IFS=$old
      [ $ok = 0 ] || { echo "must be one of $2"; return 1; } ;;
    color)
      case $v in
        '#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        *) echo "must be a colour like #rrggbb"; return 1 ;;
      esac ;;
  esac
  return 0
}

# write KEY VALUE: atomic (a temporary file in the same directory, then mv).
write() {
  f=$(path "$1")
  mkdir -p "$(dirname "$f")" || return 1
  printf '%s\n' "$2" > "$f.new" && mv "$f.new" "$f"
}

# value KEY DEFAULT: the file's line, or the default.
value() {
  f=$(path "$1")
  if [ -f "$f" ]; then IFS= read -r v < "$f"; printf '%s' "$v"; else printf '%s' "$2"; fi
}

[ -r "$SCHEMA" ] || die "no schema at $SCHEMA"

case "${1:-list}" in
  list)
    while IFS= read -r line; do
      case $line in ''|'#'*) continue ;; esac
      split "$line"
      if [ "$t" = family ]; then
        fd=$(path "$k")
        [ -d "$fd" ] || continue
        for f in "$fd"/*; do
          [ -f "$f" ] || continue
          IFS= read -r v < "$f"
          printf '%s.%s=%s\n' "$k" "${f##*/}" "$v"
        done
        continue
      fi
      if [ -f "$(path "$k")" ]; then printf '%s=%s\n' "$k" "$(value "$k" "$d")"
      else printf '%s=%s (default)\n' "$k" "$d"; fi
    done < "$SCHEMA" ;;
  get)
    [ $# -ge 2 ] || usage
    resolve "$2" || die "unknown setting: $2"
    [ "$t" != family ] || die "$2 is a family: list, or get a member, $2.NAME"
    if [ "$FAMILY" = 1 ] && [ ! -f "$(path "$k")" ]; then die "no such member: $2"; fi
    value "$k" "$d"; printf '\n' ;;
  set)
    [ $# -ge 3 ] || usage
    resolve "$2" || die "unknown setting: $2"
    [ "$t" != family ] || die "$2 is a family: set a member, $2.NAME"
    msg=$(valid "$t" "$c" "$3") || die "$2: $msg"
    write "$k" "$3" || die "cannot write $2" ;;
  unset)
    [ $# -ge 2 ] || usage
    resolve "$2" || die "unknown setting: $2"
    [ "$FAMILY" = 1 ] || die "$2 is not a family member; use reset"
    rm -f "$(path "$k")" || die "cannot remove $2" ;;
  reset)
    [ $# -ge 2 ] || usage
    resolve "$2" || die "unknown setting: $2"
    [ "$t" != family ] || die "$2 is a family: reset has nothing to do; unset a member"
    [ "$FAMILY" = 0 ] || die "$2 is a family member; use unset"
    write "$k" "$d" || die "cannot write $2" ;;
  seed)
    while IFS= read -r line; do
      case $line in ''|'#'*) continue ;; esac
      split "$line"
      if [ "$t" = family ]; then
        fd=$(path "$k")
        [ -d "$fd" ] && continue   # seeded before (even if every member was since removed)
        mkdir -p "$fd" || die "cannot create $k"
        defaults="$I/lib/config.$k.defaults"
        if [ -r "$defaults" ]; then
          while IFS="$T" read -r name val; do
            [ -n "$name" ] || continue
            printf '%s\n' "$val" > "$fd/$name.new" && mv "$fd/$name.new" "$fd/$name"
          done < "$defaults"
        fi
        continue
      fi
      [ -f "$(path "$k")" ] || write "$k" "$d" || die "cannot write $k"
    done < "$SCHEMA" ;;
  *) usage ;;
esac
