#!/system/bin/sh
#
# storage -- link phone storage into mnt/ (docs/shell.md).
#
# Each etc/storage/link/NAME (a `config` family, storage.link) holds a path;
# `storage setup` makes mnt/NAME a symlink to it. Making the link needs
# nothing from Android (a symlink is just a name); reading through it needs
# the storage permission, granted from the app's Settings screen (not this
# command's concern). `etc/profile` runs `storage setup` at the start of every
# session, so a link made with `config set storage.link.NAME /path` is there
# from the next session on; there is no watcher, since the host layer runs no
# daemon.
#
#   storage setup      (re)make every link in mnt/ from storage.link.*
#   storage list        the links, name=target (same as `config list`'s
#                        storage.link.* lines, without the key prefix)
set -u
I="${DN_INSTDIR:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
LINKS="$I/etc/storage/link"
MNT="$I/mnt"

case "${1:-setup}" in
  setup)
    mkdir -p "$MNT" || { echo "storage: cannot create $MNT" >&2; exit 1; }
    [ -d "$LINKS" ] || exit 0
    for f in "$LINKS"/*; do
      [ -f "$f" ] || continue
      name=${f##*/}
      case $name in *.new) continue ;; esac   # config's own temporary file
      IFS= read -r target < "$f"
      [ -n "$target" ] || continue
      rm -f "$MNT/$name"
      ln -s "$target" "$MNT/$name" \
        || echo "storage: could not link $name -> $target" >&2
    done
    # Drop a link whose storage.link.* member is gone (config unset removed
    # the setting, not the symlink). Only ever touches a symlink of ours.
    for f in "$MNT"/*; do
      [ -L "$f" ] || continue
      name=${f##*/}
      [ -f "$LINKS/$name" ] || rm -f "$f"
    done ;;
  list)
    [ -d "$LINKS" ] || exit 0
    for f in "$LINKS"/*; do
      [ -f "$f" ] || continue
      IFS= read -r target < "$f"
      printf '%s=%s\n' "${f##*/}" "$target"
    done ;;
  *) echo "usage: storage setup | list" >&2; exit 64 ;;
esac
