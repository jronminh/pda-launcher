# pda-launcher settings schema -- shipped, replaced when the app is updated.
# One line per setting, fields separated by a TAB:
#   key  type  default  constraint  group  description
# type: int bool enum string list path color family.  A setting is the file
# etc/<key with dots as directories>, one line, taken literally.  Read by the
# app, the screens and the `config` command alike (docs/shell.md).
launcher.homeTab	enum	apps	apps|favorites|files|shell|settings	launcher	The tab Home opens when the home screen is already showing
apps.columns	int	4	3-6	apps	Columns of the app grid
apps.rows	int	6	4-8	apps	Rows of the app grid (one page)
files.showHidden	bool	false		files	Show hidden files (names that start with a dot)
terminal.fontSize	int	14	6-40	terminal	Font size
terminal.scrollback	int	2000	100-100000	terminal	Scrollback lines (a new session)
terminal.showIme	bool	false		terminal	Raise the keyboard when the terminal resumes
terminal.foreground	color	#e0e0e0		terminal	Text colour
terminal.background	color	#000000		terminal	Background colour
terminal.keybar	list	esc,shift,,home,up,end,pgup|tab,ctrl,alt,left,down,right,pgdn		terminal	Extra keys: rows split by |, keys by ,
terminal.keybarHeight	int	2	1-3	terminal	Key bar height: 1 small, 2 normal, 3 large
ui.keepScreenOn	bool	false		ui	Keep the screen on
shell.command	string	sh -i		shell	What a new tab runs (after the profile)
shell.maxSessions	int	4	1-8	shell	Most tabs open at once
shell.failSeconds	int	5	0-60	shell	A last tab that ends non-zero within this many seconds shows an error panel (0: never)
storage.link	family		path	storage	A phone folder linked into mnt/NAME
